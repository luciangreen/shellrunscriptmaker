{
  "name": "Breasoning (weekly, 25 million)",
  "description": "From the private repo instructions: breason out file.txt with Text-to-Breasonings, run Grammar Logic, run gl2a, then breason the gl2a output. Br = 4 x 50 x 80 = 16,000 (target / 80).",
  "stopOnFail": true,
  "tempDir": false,
  "steps": [
    {
      "type": "pause",
      "message": "Is this for a thesis? If so, press Stop: no breasoning for theses yet. Otherwise Continue."
    },
    {
      "type": "prolog",
      "cwd": "Dropbox/GitHub-private2/Text-to-Breasonings",
      "goals": [
        "['text_to_breasonings.pl']",
        "N=u,M=u,texttobr2(N,\"file.txt\",u,M,[auto,on])"
      ],
      "stackLimit": "54G",
      "interactive": false,
      "stdoutTo": ""
    },
    {
      "type": "pause",
      "message": "STOP HERE, THEN DO BELOW"
    },
    {
      "type": "prolog",
      "cwd": "Dropbox/GitHub-private2/Text-to-Breasonings",
      "goals": [
        "['text_to_breasonings.pl']",
        "N=u,M=u,texttobr(N,\"file.txt\",u,M)"
      ],
      "stackLimit": "54G",
      "interactive": false,
      "stdoutTo": ""
    },
    {
      "type": "prolog",
      "cwd": "Dropbox/GitHub-private2/Algorithm-Writer-with-Lists",
      "goals": [
        "['grammar_logic_to_alg.pl']",
        "['../Text-to-Breasonings/text_to_breasonings.pl'], FileName2=\"./gl2a.txt\", FileName3=\"gl2a.txt\", protocol(FileName2)",
        "notrace",
        "As is 4*50,Br is As*80,open_string_file_s(\"../Text-to-Breasonings/file.txt\",Essay_0),grammar_logic_to_alg1(Essay_0,Br,GL_out1),term_to_atom(GL_out1,GL_out2),string_atom(GL_out,GL_out2),working_directory1(_,\"../Text-to-Breasonings\"),texttobr2(u,u,GL_out,u,[auto,on]),texttobr(u,u,GL_out,u)",
        "noprotocol"
      ],
      "stackLimit": "54G",
      "interactive": false,
      "stdoutTo": ""
    },
    {
      "type": "cmd",
      "cwd": "Dropbox/GitHub-private2/Algorithm-Writer-with-Lists",
      "cmd": "mv",
      "args": [
        "gl2a.txt",
        "../Text-to-Breasonings/file.txt"
      ]
    }
  ]
}
